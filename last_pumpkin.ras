program lastpumpkin;
/*
    The Last Pumpkin made by CommodoreSpence
    
    This game takes the small_game for the C128 tutorial and makes a more complete game out of it with an Halloween theme for C64
    The Tileset GFX was created and exported in Charpad Pro
    
    Sprite and Title screen created in TRSE editors and Spritepad Pro
    
    Music by Abynx
*/
var  
    count,i,k,l,gameOver,level,colTimeout,ty,py,joyTimeout,paddleY,paddleFired,paddleInput: byte; 
    paddleX,playerScore,xSpeed,ySpeed,jitter,tx,px,speed : integer;
    m,paddleXr,paddleYr,paddleFirer : pointer;
    ghost_type = record
        active : byte;
        x,cx   : integer;
        y,cy   : byte;
    end;
    rasterLine      : byte = 240;
    sprite_priority : pointer;
    slot,sprChk     : byte; //Global Sprite slot buffers
    ghostSprite     : byte = @spriteLoc/64+2;
    catRightSprite  : byte = @spriteLoc/64+3;     
    catLeftSprite   : byte = @spriteLoc/64+6;
    catSitSprite    : byte = @spriteLoc/64+5; 
   
    //Animation
    cats            : byte = 0;
    catDelay        : byte = 0;
    //Obstacles
    entity_type = record
        anim    : byte; //Animated 0 or 1
        aStart  : byte; //Mem Location of sprite, only needed for animated entities
        aStop   : byte; //Max Frames
        aFrame  : byte; //Counter for animation
        aDelay  : byte; //Slow down
        x       : integer;
        y       : byte; //x y pixel pos of entity sprite
        color   : byte; //Main color of entity sprite
        active  : byte; //active or not active, maintainSprite will draw/move based on active/inactive
        yspeed  : byte; //speed of Y pixel movement
        xspeed  : byte; //x speed pixel movement
        diry    : byte; //up down or nowhere 0 2 1
        dirx    : byte; //left center or right 0 1 2
        fDelay  : integer; //fire delay
        mdelay  : byte; //movement delay counter
        mSet    : byte; //movent default value (set in spawn)
        health  : byte; //health value
        crash   : byte; //distance from center to count a hit
        flash   : byte;
        sprSlot : byte; //sprite
        entity  : byte; //numerical represenation of type of entity
        oid     : byte; //Player ID of last player to influence the entity (like asteroids) 
        bbx     : integer; //bounding box max X
        bby     : byte; //bounding box max Y
    end;
    maxEntity : byte;
    entities  : array[6] of entity_type;
    cObsDelay : byte = 100;
    
    @define spriteLoc  $3000
    //Binary files
    const charsetLocation  : address = $2000;
    charset                : IncBin("characters/Chars.bin",charsetLocation); //Main charset
    colors                 : Incbin("characters/CharAttribs_L1.bin",charsetLocation+$5b9); //Charset colour assignments per char
    tile_data              : Incbin("characters/Tiles.bin",charsetLocation+$5b9+$b7); //tiles for the level
    map_data               : Incbin("characters/Map.bin",charsetLocation+$5b9+$b7+$81); //map of tiles 
    title_image            : Incbin("characters/title_data.bin",$6000); 
    title_color            : Incbin("characters/title_color.bin",$5000);
    sidfile                : IncSid("sid/tlp.sid",2); //PumpkinSpice by Abynx
    sprites                : Incbin("sprites/lastpumpkin_sprites.bin", @spriteLoc);

@export "characters/pumpkin.flf" "characters/title.bin" 256


//forward declare subs that need it
procedure InitVariables();
interrupt GameLoop();
procedure spriteSlot();
//Obstacles
procedure maintainObstacles();
procedure createObstacle();
procedure spawnGhosts();
procedure resetObstacles();

//external files
@include "obstacles.ras"

/*
    Check Joystick or Paddle input for the player
*/

procedure readPaddle();
/*
    Collect Paddle data from port 1 paddle/mouse registers
*/
begin
    paddleXr    := $D419;
    paddleYr    := $D41A;
    paddleFirer := $DC01;
    paddleX     := paddleXr[0];
    paddleY     := paddleYr[0]; //dont really need to Poll Y, not using a mouse
    if (paddleFirer[0] = 247) then paddleFired := 1; //paddles can have 2 buttons, i only need one so if either is pressed fire will be flagged
    if (paddleFirer[0] = 251) then paddleFired := 1;	
    if (paddleFirer[0] = 255) then paddleFired := 0;	
end;

procedure CheckInput();
var
    firePressed : byte;
begin
    if(paddleInput = 1) then begin
        readPaddle();
        if catDelay = 0 then begin
            if(paddleX > 50) then px := 70 + paddleX - 50;
        end else dec(catDelay);
    end else begin
        firePressed := 0; 
        Joystick(2);
        if(joystickbutton=1) then firePressed := 2; //move faster with fire pressed
        if catDelay = 0 then begin //Cat collisions cause intermittent interruptions to movement
            if(joystickleft=1) then begin
                if px > 69 then px := px - 2 - firePressed;
            end;    
            if(joystickright=1) then begin 
                if px < 275 then px := px + 2 + firePressed;
            end;
        end else dec(catDelay);
    end;
end;

/*
    Check Snowball to Wall collision. Fixed positions so easy peasy
*/
procedure CheckBounce();
begin
    /*
     interesting issue arose where the math wasn't working like it did in BASIC 7
     If I tried to do a negative number with integer it went haywire
     If I use byte then obviously I run out of allocation on the X axis
     So I hacked this together instead and it seems to work
     
     The on/off of xSpeed (and y) just indicates whether to add from x/y or minus
    */
    
    if tx <= 69  then xSpeed := 1;
    if tx >= 271 then xSpeed := 0;
    if ty <= 75  then ySpeed := 1;
    if ty >= 220 then gameOver := 1; //Oops you Missed!
    
    if xSpeed = 0 then tx := tx - speed - jitter
    else tx := tx + speed + jitter;
    if ySpeed = 0 then ty := ty - speed
    else ty := ty + speed;
end;

/*
    Check Player to Pumpkin Collision
*/
procedure CheckCollision();
var
    col : byte;
    cci : byte;
begin
    col  := 0;
    col  := sprite_collision; //capture collisions every frame to reset registers
    
    //player to pumpkin check
    if((getbit(col,1) = 1) AND (getbit(col,0) = 1)) then begin
        if (abs(ty - py) < 24) then begin
            if (abs(tx - px) < 21) then begin    
                //sprite 1 (player) and 0 (pumpkin) involved in a collision 
                ySpeed     := 0;
                ty         := ty - speed;
                if colTimeout = 0 then begin
                    playerScore := playerScore + 10;
                    colTimeout := 10;
                    moveto(12,0,$04);
	                printdecimal(playerScore,4);
	                fillfast((screen_col_loc+12),white,4); //make sure the text background matches
                    level := (playerScore / 100);
                    if ty > 180 then jitter := 1 //mess with the angle a bit
                    else jitter := 0;
                end;
            end;
        end;
    end;
    //entities, ghosts, cats
    if maxEntity = 0 then return;
    for cci := 0 to maxEntity do begin
         if entities[cci].active = 1 then begin
              if entities[cci].entity = 2 then begin 
                  //player to cat
                  if(getbit(col,1) = 1 AND getbit(col,entities[cci].sprSlot) = 1) then begin
                      if (abs(px - entities[cci].x) < 21) then begin     
                          if (catDelay = 0 AND colTimeout = 0) then begin 
                              if paddleInput = 1 then catDelay := 6 
                              else catDelay := 3;
                              colTimeout := 10;
                          end;
                      end;    
                  end;    
              end;
              //Pumpkin to Ghost or Cat
              if(getbit(col,0) = 1 AND getbit(col,entities[cci].sprSlot) = 1) then begin
                  if (abs(ty - entities[cci].y) < 24) then begin
                      if (abs(tx - entities[cci].x) < 21) then begin
                          if ySpeed = 0 then begin
                              ySpeed := 1;
                          end else begin
                              ySpeed := 0;
                          end;
                          colTimeout := 10;
                           
                          if entities[cci].entity = 2 then begin 
                              entities[cci].mdelay := 120;
                              entities[cci].aDelay := 120;
                              ySpeed := 0; //dont bounce down from cat
                              setspriteloc(entities[cci].sprSlot,catSitSprite,0);
                          end else begin
                              togglebit(SPRITE_BITMASK,entities[cci].sprSlot,0); //Turn off sprite (this caused SprSlot leak not having it)    
                              entities[cci].active := 0;
                          end;
                      end;
                  end;  
              end;     
         end;
    end;
end;

procedure CheckLevel();
//Make sure vars are set according to level
begin
    case level of
        1:  maxEntity := 1; //first ghost appears at score 100
        2:  maxEntity := 2;
        3:  maxEntity := 3;
        4:  maxEntity := 4; //haha! now it's 4! Score 400
        5:  maxEntity := 5; //still alive?!
        6:  maxEntity := 6; //max ghosts!!
        7:  speed     := 2; //Eat double speed!!
        10: speed     := 3; //ludicrous speed!!! Score 1000
    end;   
end;

/*
    Player lost, freeze game until fire is pressed and reset all variables
*/
procedure GameOver();
begin
    PreventIRQ();
    clearsound(); //clear SID channels
    moveto(15,11,$04);
    printstring("GAME OVER!",0,10);
    fillfast((screen_col_loc+(11*40)+15),white,9); //make sure the text background matches
    while (1) do begin
        readPaddle();
        readjoy2();
        if joy2pressed & JOY_FIRE then break;
        if paddleFired then break;
    end;
    resetObstacles();
    printstring("          ",0,10);
    fillfast((screen_col_loc+(11*40)+15),white,9); //make sure the text background matches
    //Reset everything to starting values and positions
    InitVariables();
    //Move Pumpkin to starting position
    spritepos(tx,ty,0);
    //Move player to starting position
    spritepos(px,py,1);
    //Clear Score
    moveto(12,0,$04);
    printdecimal(playerScore,4);
    initsid(SIDFILE_1_INIT);
    StartRasterChain(GameLoop(), rasterLine, 1);
end;

/*
    Run through the process of executing the game.
    Keeping the loop small makes it easy to debug
*/
interrupt GameLoop();
begin
    StartIRQ(1);
    call(SIDFILE_1_PLAY); //Great tune
    if colTimeout > 0 then begin  //used to scoring and jitter reaction so you dont get multiple points or jitter applied
        colTimeout := colTimeout - 1;
    end;
    //Check gameover and pause if Game is over
    if gameOver = 1 then GameOver();
    CheckBounce(); //Check pumpkin sprite to character wall boundaries
    maintainObstacles(); //Move Ghosts
    spritepos(tx,ty,0); //Update Pumpkin
    spritepos(px,py,1); //Update Skeleton
    //Check Input
    CheckInput(); //Joy/paddle handler
    CheckCollision(); //Collisions, player to pumpkin, pumpkin to ghosts, cats
    createObstacle(); //Create Ghosts when appropriate
    CheckLevel(); //Update game vars based on score
    closeirq();
end;

procedure TitleStart();
begin
    //Switch to bank1 and display bitmap title screen
    setbank(vic_bank1);
    setmulticolormode();
    setbitmapmode();
    copyimagecolordata(#title_color,1);
    while (keypressed(key_space) <> 1) do begin //Stay until space is pressed
    end;	
    setbank(vic_bank0); //Go back to bank 0 for the gameplay
    settextmode();
    setmulticolormode();
end;

/*
   Freeze the game until fire is pressed to start the game
*/
procedure GameStart();
begin
    moveto(15,11,$04);
    printstring("PRESS FIRE!",0,11);
    moveto(15,11,hi(screen_col_loc));
    fillfast((screen_col_loc+(11*40)+15),white,10); //make sure the text background matches
    while (1) do begin //Wait until fire on joystick or paddle pressed
        readPaddle();
        readjoy2();
        if joy2pressed & JOY_FIRE then break;
        if paddleFired then break;
    end;
    if paddleFired = 1 then paddleInput := 1; //Paddle input for game
    moveto(15,11,$04);
    printstring("           ",0,11);	
    fillfast((screen_col_loc+(11*40)+15),white,10); //make sure the text background matches
end;

// Prints a 2x2 block at position x,y with the upper left value of c, (and c+1, c+2 and c+3)
// Also prints colors based of the "colors" pointer 
// Original credit to the TRSE game tutorial with minor modifications
procedure print2x2block(x,y,c:byte);
begin
    moveto(x,y,hi(screen_char_loc));
    screenmemory[0] :=tile_data[c];
    screenmemory[1] :=tile_data[c+1];
    screenmemory[40]:=tile_data[c+2];
    screenmemory[41]:=tile_data[c+3];
    //Colouring, the tile_data will return the char value via c and thus provide the correct item to colour
    moveto(x,y,hi(screen_col_loc));
    screenmemory[0] :=colors[tile_data[c]];
    screenmemory[1] :=colors[tile_data[c+1]];
    screenmemory[40]:=colors[tile_data[c+2]];
    screenmemory[41]:=colors[tile_data[c+3]];
end;

//Print a map starting at mapx
//assuming mapheight = 12
//assuming screen tiles = 240
procedure printLongMap(mapx,mapl:byte);
begin
    k:=0;
    l:=0;
    m:=#map_data+mapx;
    for i:=1 to 241 do begin
        print2x2block(k,l,@m[0]*4);
        k:=k+2;
        if k >= 41 then begin
            k:=1;
            l:=l+2;
            m:=m+mapl-20;
        end;
        m:=m+$1
    end;	
end;

procedure DrawLevel();
begin
    //Draw map tiles
    printLongMap(0,21);
    //Draw the Score area
    moveto(5,0,$04);
    printstring("SCORE: ",0,7); 
    fillfast((screen_col_loc+5),white,6); //make sure the text background matches
    //Move Pumpkin to starting position
    spritepos(tx,ty,0);
    //Move Player to starting position
    spritepos(px,py,1);
end;

/*
    Set all game variables to default starting values
*/

procedure InitVariables();
begin
    tx              := 120 + (Random() & 40); //Pumpkin placement will be slightly varied to that gameplay isnt the same every time
    ty              := 150;
    px              := 150;
    py              := 195;
    playerScore     := 0;
    speed           := 1;
    xSpeed          := Random() & 1; //Left or right randomness on first movement
    ySpeed          := 0;
    gameOver        := 0;
    level           := 0;
    colTimeout      := 10;
    jitter          := 0;
    count           := 5;
    joyTimeout      := 0;
    sprite_priority := $d01b; //pointer to priority toggle
    maxEntity       := 0;
    cats            := 0;
    catDelay        := 0;
end;

procedure spriteSlot();
var 
    spI : byte;

//find a sprite slot
begin
    slot := 255;
    for spI := 0 to 8 do begin
        sprChk := getbit(SPRITE_BITMASK,spI);
        if(sprChk = 0) then begin
            slot := spI;
            togglebit(SPRITE_STRETCH_X,slot,0); 
	        togglebit(SPRITE_STRETCH_Y,slot,0);
            return;
        end;
    end;	
end;

procedure InitSprites();
begin
    //Init Sprites, No MultiColour 1 and Multicolour 2 Sprites turned on, no stretching, Colours
    sprite_multicolor :=%00111110;
    sprite_bitmask    :=%00000011;
    sprite_stretch_x  :=$00;
    sprite_stretch_y  :=$00;
    sprite_color[0]   :=orange;	
    sprite_color[1]   :=white;
    SPRITE_MULTICOLOR_REG1 := red;
    SPRITE_MULTICOLOR_REG2 := orange;
    //Set Sprite pointers to the memory location we included them in increments of 64 bytes
    setspriteloc(0,@spriteLoc/64, 0); //pumpkin
    setspriteloc(1,@spriteLoc/64+1, 0); //skeleton
   
end;

procedure InitScreen();
begin
    //This function sets up the screen mode, colours and clears the screen
    screen_fg_col:=black;
    screen_bg_col:=black;
    multicolor_char_col[1]:=black;
    multicolor_char_col[2]:=brown;
    setmulticolormode();
    hideborderx(1);
    ClearScreen(key_space,screen_char_loc);
    // Fill the upper screen color ram with black
    ClearScreen(black, SCREEN_COL_LOC);
end;

begin
    SetMemoryConfig(1,1,0); //IO Kernal no BASIC
    SetCharsetLocation(charsetLocation); 
    TitleStart(); //Bitmap title screen on Bank 1
    InitScreen(); 
    InitVariables();
    InitSprites();
    DrawLevel();
    GameStart();
    initsid(SIDFILE_1_INIT);
    StartRasterChain(GameLoop(), rasterLine, 1);
    loop();
end.
