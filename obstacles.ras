procedure createObstacle();
begin
    if maxEntity = 0 then return;
	dec(cObsDelay);
    if cObsDelay > 0 then return;
    cObsDelay := 100;
	for i:=0 to maxEntity do begin
		if entities[i].active = 0 then begin
			spriteSlot();                
	        if slot = 255 then return; //no slots
		    entities[i].active := 1;
	        entities[i].flash  := 0;
	        entities[i].diry   := 1;
            entities[i].xspeed := 1;
            entities[i].yspeed := 0; 
            entities[i].mdelay := 0;
 
            if( (Random() & 1) = 0) then begin
	            entities[i].x    := 343;
                entities[i].dirx := 0;    
            end else begin
	            entities[i].x    := 0;
	            entities[i].dirx := 2;
            end;
	        if ( level > 3 AND cats = 0 ) then begin
	            entities[i].aDelay := 0;
	            entities[i].y := 195; //cat y should match player y
	            if entities[i].dirx = 0 then spawnRightCats()
                else spawnLeftCats();
                cats := 1;
                return; 
            end; 
            entities[i].y := (Random() & 85)+90; //ghost y can vary
            spawnGhost();
            return;  	
		end;
    end;
end;
